# Supabase (client-safe values are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only; used by /api/extract and catalog scripts)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini vision for /api/extract (server-only, never exposed to the client)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_SCAN_MODELS=gemini-3-flash-preview,gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# TinyFish (server-only)
TINYFISH_API_KEY=
# Set to "false" to disable all TinyFish agent runs (search/fetch still work)
TINYFISH_ENABLED=true
# Max TinyFish agent runs (verify/price/alert_sync) allowed per UTC day
TINYFISH_DAILY_CAP=40

# Storage buckets (comma-separated) cleaned up on "Delete all my data"
MEDSCAN_STORAGE_BUCKETS=medicine-images

# Shared secret for the cron routes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

ALERT_SOURCE_URL=https://cdscoonline.gov.in/CDSCO/viewPublicNSQDrug
VERIFY_SOURCE_URLS=https://www.1mg.com/search/all?name={query},https://pharmeasy.in/search/all?name={query}
TRUSTED_INFO_DOMAINS=medlineplus.gov,nhs.uk,mayoclinic.org

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact subject required by the Web Push spec (mailto: or https: URL)
VAPID_SUBJECT=mailto:care@medscan.app
# HMAC secret for signed, short-lived dose action links in push notifications.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Falls back to VAPID_PRIVATE_KEY when unset.
PUSH_ACTION_SECRET=

# Twilio (server-only) — caregiver escalation fallback when push cannot reach.
# The auth token is never logged or sent to the client.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender, e.g. +14155550123
TWILIO_SMS_FROM=
# WhatsApp sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
NEXT_PUBLIC_APP_URL=https://dawasarthi.vercel.app

# Caregiver join rate limit (server-only). Set to "true" ONLY while testing
# locally to skip the failed-attempt limit; MUST stay unset/off in production.
JOIN_RATE_LIMIT_DISABLED=